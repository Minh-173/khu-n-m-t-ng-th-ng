                        <button class="control-btn stop-btn" id="stopBtn"><i class="fas fa-stop"></i> Stop (F8)</button>
                    </div>
                    <div class="log-container" id="logContainer"></div>
                </div>
            `;
            if (document.body) {
                document.body.appendChild(dashboardElement);
                this.dashboardElement = dashboardElement;
                this.setupEventListeners();
            } else {
                throw new Error('document.body chưa sẵn sàng. Không thể gắn dashboard.');
            }
        }

        setupEventListeners() {
            const startBtn = document.getElementById('startBtn');
            const stopBtn = document.getElementById('stopBtn');
            const minimizeBtn = document.getElementById('minimizeBtn');
            const closeBtn = document.getElementById('closeBtn');
            const dashboardHeader = this.dashboardElement.querySelector('.dashboard-header');
            const dashboardContent = this.dashboardElement.querySelector('.dashboard-content');

            startBtn.addEventListener('click', startTool);
            stopBtn.addEventListener('click', stopTool);

            minimizeBtn.addEventListener('click', () => {
                this.isMinimized = !this.isMinimized;
                this.dashboardElement.classList.toggle('minimized', this.isMinimized);
                dashboardContent.style.opacity = this.isMinimized ? '0' : '1';
                dashboardContent.style.height = this.isMinimized ? '0px' : 'auto';
                dashboardContent.style.padding = this.isMinimized ? '0px' : 'initial';
                dashboardContent.style.marginBottom = this.isMinimized ? '0px' : 'initial';
                dashboardContent.style.pointerEvents = this.isMinimized ? 'none' : 'auto';
                
                minimizeBtn.innerHTML = this.isMinimized ? '<i class="fas fa-window-maximize"></i>' : '<i class="fas fa-window-minimize"></i>';
            });

            closeBtn.addEventListener('click', () => {
                if (confirm("Bạn có chắc chắn muốn đóng bảng điều khiển và dừng toàn bộ tiến trình của tool không?")) {
                    isRunning = false;
                    statisticsInstance.stopTimer();
                    this.dashboardElement.style.opacity = '0';
                    this.dashboardElement.style.transform = 'scale(0.7) translateY(50px)';
                    setTimeout(() => {
                        this.dashboardElement.remove();
                        console.log('HeoDevxCoder AI: Bảng điều khiển đã đóng và tool đã dừng hoàn toàn.');
                    }, 600);
                }
            });

            dashboardHeader.addEventListener('mousedown', (e) => {
                if (e.target.closest('.header-controls')) return;
                this.drag.active = true;
                this.dashboardElement.style.transition = 'none';
                this.dashboardElement.style.cursor = 'grabbing';
                this.drag.offsetX = e.clientX - this.dashboardElement.getBoundingClientRect().left;
                this.drag.offsetY = e.clientY - this.dashboardElement.getBoundingClientRect().top;
                e.preventDefault();
            });

            document.addEventListener('mousemove', (e) => {
                if (!this.drag.active) return;
                const x = e.clientX - this.drag.offsetX;
                const y = e.clientY - this.drag.offsetY;
                this.dashboardElement.style.left = `${x}px`;
                this.dashboardElement.style.top = `${y}px`;
                const dashRect = this.dashboardElement.getBoundingClientRect();
                if (dashRect.left < 0) this.dashboardElement.style.left = '0px';
                if (dashRect.top < 0) this.dashboardElement.style.top = '0px';
                if (dashRect.right > window.innerWidth) this.dashboardElement.style.left = `${window.innerWidth - dashRect.width}px`;
                if (dashRect.bottom > window.innerHeight) this.dashboardElement.style.top = `${window.innerHeight - dashRect.height}px`;
            });

            document.addEventListener('mouseup', () => {
                if (this.drag.active) {
                    this.drag.active = false;
                    this.dashboardElement.style.transition = 'all var(--anim-duration-normal) cubic-bezier(0.2, 0.8, 0.2, 1)';
                    this.dashboardElement.style.cursor = 'grab';
                }
            });
        }

        addLog(message, type = 'info') {
            const logContainer = document.getElementById('logContainer');
            if (!logContainer) {
                console.log(`[Log Error - ${type.toUpperCase()}] ${message}`);
                return;
            }

            const log = { message, type, timestamp: new Date() };
            this.logs.unshift(log);
            if (this.logs.length > 50) this.logs.pop();

            const logElement = document.createElement('div');
            logElement.className = `log-entry log-${type}`;
            logElement.innerHTML = `
                ${type === 'success' ? '<i class="fas fa-check-circle"></i>' : ''}
                ${type === 'error' ? '<i class="fas fa-times-circle"></i>' : ''}
                ${type === 'info' ? '<i class="fas fa-info-circle"></i>' : ''}
                <span>[${log.timestamp.toLocaleTimeString()}] ${message}</span>
            `;
            
            logContainer.insertBefore(logElement, logContainer.firstChild);

            while (logContainer.children.length > 50) {
                logContainer.removeChild(logContainer.lastChild);
            }
        }
    }

    // --- Các hàm logic chính của tool ---
    async function delay(min, max, progressCallback) {
        const waitTime = Math.floor(Math.random() * (max - min + 1)) + min;
        const startTime = Date.now();
        
        return new Promise(resolve => {
            const interval = setInterval(() => {
                const elapsed = Date.now() - startTime;
                const progress = Math.min(elapsed / waitTime, 1);
                if (progressCallback) progressCallback(progress);
                
                if (elapsed >= waitTime) {
                    clearInterval(interval);
                    resolve();
                }
            }, 100);
        });
    }

    async function waitForElement(selector, timeout = 30000) {
        const startTime = Date.now();
        
        while (Date.now() - startTime < timeout && isRunning) {
            const element = typeof selector === 'string' ? 
                (selector.startsWith('//') ? 
                    document.evaluate(selector, document, null, XPathResult.FIRST_ORDERED_NODE_TYPE, null).singleNodeValue :
                    document.querySelector(selector)) :
                selector;

            if (element && !element.disabled && element.offsetParent !== null) {
                const style = window.getComputedStyle(element);
                if (style.display !== 'none' && style.visibility !== 'hidden' && style.opacity !== '0') {
                    return element;
                }
            }
            await new Promise(r => setTimeout(r, 200));
        }
        
        if (!isRunning) {
            throw new GolikeError('TOOL_STOPPED', 'Tool đã dừng bởi người dùng.');
        }
        throw new GolikeError('ELEMENT_NOT_FOUND', `Không tìm thấy element: "${selector}" sau ${timeout / 1000} giây`);
    }

    async function safeClick(element, beforeDelay, afterDelay) {
        if (!isRunning) throw new GolikeError('TOOL_STOPPED', 'Tool đã dừng trước khi click.');

        try {
            dashboardInstance.addLog(`Đợi ${beforeDelay[0] / 1000}s trước khi click...`, 'info');
            await delay(...beforeDelay);
            
            if (!isRunning) throw new GolikeError('TOOL_STOPPED', 'Tool đã dừng trong lúc đợi click.');

            element.scrollIntoView({ behavior: 'smooth', block: 'center' });
            await delay(500, 1000);
            
            element.click();
            dashboardInstance.addLog('Đã click thành công!', 'success');
            
            dashboardInstance.addLog(`Đợi ${afterDelay[0] / 1000}s sau khi click...`, 'info');
            await delay(...afterDelay);
            
            return true;
        } catch (e) {
            if (e.type === 'TOOL_STOPPED') {
                throw e;
            }
            dashboardInstance.addLog(`Lỗi khi click: ${e.message}`, 'error');
            return false;
        }
    }

    // ==================== HÀM KIỂM TRA POPUP "CHƯA CÓ JOBS MỚI" ====================
    async function handleNoJobsPopup() {
        try {
            // Selector để tìm popup "Hiện tại chưa có jobs mới"
            const popupContent = document.getElementById('swal2-content');
            
            if (popupContent && popupContent.style.display !== 'none') {
                const text = popupContent.textContent.trim();
                if (text.includes('chưa có jobs mới') || text.includes('vui lòng nghỉ tay')) {
                    dashboardInstance.addLog('⚠️  Phát hiện popup: "Chưa có jobs mới, vui lòng nghỉ tay và quay lại sau 30p!"', 'info');
                    dashboardInstance.addLog('⏳ Đang chờ 30 phút trước khi tiếp tục...', 'info');
                    
                    // Đóng popup bằng cách tìm nút OK
                    const okButton = document.querySelector('.swal2-confirm, button.btn-primary[onclick*="confirm"]');
                    if (okButton) {
                        okButton.click();
                        await delay(500, 1000);
                    }
                    
                    // Đợi 30 phút (1800000 ms) với log hằng giây
                    const waitDuration = 1800000; // 30 phút
                    const logInterval = 60000; // Log mỗi 1 phút
                    let elapsed = 0;
                    
                    while (elapsed < waitDuration && isRunning) {
                        const remainingMinutes = Math.ceil((waitDuration - elapsed) / 60000);
                        if (elapsed % logInterval === 0) {
                            dashboardInstance.addLog(`Còn lại ${remainingMinutes} phút để chờ...`, 'info');
                        }
                        await delay(60000, 60000);
                        elapsed += 60000;
                    }
                    
                    if (isRunning) {
                        dashboardInstance.addLog('✅ Đã chờ đủ 30 phút. Tiếp tục lấy jobs...', 'success');
                    }
                    
                    return true; // Popup được xử lý
                }
            }
        } catch (e) {
            console.error('Lỗi khi xử lý popup chưa có jobs:', e);
        }
        
        return false; // Không có popup
    }

    // ==================== HÀM BÁO CÁO LỖI ĐƯỢC CẢI TIẾN ====================
    async function reportError() {
        if (!isRunning) throw new GolikeError('TOOL_STOPPED', 'Tool đã dừng khi đang báo lỗi nhiệm vụ.');

        try {
            dashboardInstance.addLog('🔴 Báo cáo lỗi nhiệm vụ...', 'info');
            
