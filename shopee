            isRunning = false;
            statisticsInstance.stopTimer();
            document.getElementById('stopBtn').classList.add('active');
            document.getElementById('startBtn').classList.remove('active');
            dashboardInstance.addLog('🛑 Dừng tool...', 'info');
        } else {
            dashboardInstance.addLog('⚠️  Tool chưa chạy. Nhấn Start để khởi động!', 'info');
        }
    }

