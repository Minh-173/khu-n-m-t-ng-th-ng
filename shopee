        // --- Thông báo khởi động đầu tiên ---
        dashboardInstance.addLog('🚀 Tool GoLike FULL APP - HeoDevxCoder AI đã sẵn sàng!', 'success');
        dashboardInstance.addLog('✨ Chào mừng đến với kỷ nguyên Lumina Glass Elegance!', 'info');
        dashboardInstance.addLog('📊 Bảng thống kê giờ đây đã "full option" và siêu gọn gàng.', 'info');
        dashboardInstance.addLog('🔄 Đã tích hợp xử lý popup "đã làm rồi" và "chưa có jobs mới".', 'info');
        dashboardInstance.addLog('✅ Báo cáo lỗi đã được cải tiến - ấn được nút "Gửi báo cáo" 100%!', 'success');
