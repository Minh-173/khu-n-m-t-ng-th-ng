    async function getJobInfo() {
        if (!isRunning) throw new GolikeError('TOOL_STOPPED', 'Tool đã dừng khi đang lấy thông tin nhiệm vụ.');

        try {
            const jobTypeElement = await waitForElement("span.ml-1.d400.font-weight-bold", 10000);
            const jobType = jobTypeElement ? jobTypeElement.textContent.trim() : "Không xác định";

            const moneyElement = await waitForElement("span.money-return span.font-bold", 10000);
            const earnings = moneyElement ? parseInt(moneyElement.textContent.replace(/[^\d]/g, '')) : 0;

            const jobIdElement = await waitForElement(".font-14.d400.col-12.text-center.py-2 b", 10000);
            const jobId = jobIdElement ? jobIdElement.textContent.trim() : "N/A";

            const timeElement = await waitForElement("h6 b.red:first-child", 10000);
            const timeRemaining = timeElement ? parseInt(timeElement.textContent) : 0;

            const remainingElement = await waitForElement("span.font-14.font-light span.font-bold", 10000);
            const remainingCount = remainingElement ? parseInt(remainingElement.textContent) : 0;

            const totalTextElement = await waitForElement("span.font-14.font-light");
            const totalMatch = totalTextElement.textContent.match(/\/\s*(\d+)/);
            const totalCount = totalMatch ? parseInt(totalMatch[1]) : 0;

            return {
                type: jobType,
                earnings: earnings,
                jobId: jobId,
                timeRemaining: timeRemaining,
                remaining: remainingCount,
                total: totalCount
            };
        } catch (e) {
            if (e.type === 'TOOL_STOPPED') throw e;
            dashboardInstance.addLog(`❌ Lỗi khi đọc thông tin nhiệm vụ: ${e.message}`, 'error');
            return null;
        }
    }

    // ==================== HÀM CHÍNH RUN GOLIKE PROCESS ====================
    async function runGolikeProcess() {
        while (isRunning) {
            const jobStartTime = Date.now();
            let jobSuccess = false;
            let jobInfo = null;
            let jobSkipped = false;

            try {
                dashboardInstance.addLog('📋 Chuẩn bị nhận nhiệm vụ mới...', 'info');

                // Kiểm tra popup "chưa có jobs mới"
                if (await handleNoJobsPopup()) {
                    if (isRunning) {
                        await delay(3000, 5000);
                        continue;
                    } else {
                        break;
                    }
                }

                const getJobButton = await waitForElement("div.btn.btn-outline-light", 25000);
                dashboardInstance.addLog('✓ Tìm thấy nút nhận job, đang click...', 'info');
                await safeClick(getJobButton, [2000, 3000], [3000, 4000]);

                // Kiểm tra popup "đã làm rồi"
                await handleAlreadyDonePopup();

                // Kiểm tra lại popup "chưa có jobs"
                if (await handleNoJobsPopup()) {
                    if (isRunning) {
                        await delay(3000, 5000);
                        continue;
                    } else {
                        break;
                    }
                }

                jobInfo = await getJobInfo();
                if (jobInfo) {
                    dashboardInstance.addLog(`📌 Đã nhận nhiệm vụ: ${jobInfo.type} (ID: ${jobInfo.jobId})`, 'info');
                    dashboardInstance.addLog(`💰 Kiếm được: ${jobInfo.earnings} xu. Thời gian còn: ${jobInfo.timeRemaining}s`, 'info');
                    dashboardInstance.addLog(`📊 Số lượng còn: ${jobInfo.remaining}/${jobInfo.total}`, 'info');
                } else {
                    throw new GolikeError('JOB_INFO_ERROR', 'Không lấy được thông tin nhiệm vụ, có thể job đã hết hoặc lỗi trang.');
                }

                const shopeeLink = await waitForElement("a.btn.bg-button-1.px-0.btn-block", jobInfo.timeRemaining * 1000 - 5000);
                dashboardInstance.addLog('🔗 Tìm thấy link Shopee, đang mở...', 'info');
                await safeClick(shopeeLink, [3000, 4000], [4000, 5000]);

                let completeButton = null;
                let retryCount = 0;
                const maxRetries = 3;
                
                while (retryCount < maxRetries && isRunning) {
                    try {
                        completeButton = await waitForElement("button.btn.btn-block.b-0.bg-button-1.px-0:has(img[src*='success.svg'])", 18000);
                        
                        if (completeButton && !completeButton.disabled) {
                            dashboardInstance.addLog('✓ Tìm thấy nút hoàn thành, đang thử click...', 'info');
                            if (await safeClick(completeButton, [2000, 3000], [3000, 4000])) {
                                jobSuccess = true;
                                dashboardInstance.addLog(`✅ Hoàn thành nhiệm vụ thành công! Bạn nhận được ${jobInfo.earnings} xu.`, 'success');
                                break;
                            }
                        } else {
                            throw new GolikeError('BUTTON_DISABLED', 'Nút hoàn thành đang bị vô hiệu hóa.');
                        }
                    } catch (e) {
                        if (e.type === 'TOOL_STOPPED') throw e;
                        retryCount++;
                        dashboardInstance.addLog(`⚠️  Thử lại hoàn thành nhiệm vụ lần ${retryCount}/${maxRetries}. Lỗi: ${e.message}`, 'error');
                        await delay(4000, 7000);
                    }
                }

                if (!jobSuccess) {
                    dashboardInstance.addLog('❌ Không thể hoàn thành nhiệm vụ sau nhiều lần thử, báo cáo lỗi...', 'error');
                    await reportError();
                }

            } catch (error) {
                if (error.type === 'TOOL_STOPPED') {
                    dashboardInstance.addLog('🛑 Tool đã dừng hoạt động.', 'info');
                    isRunning = false;
                } else if (error.type === 'JOB_ALREADY_DONE') {
                    dashboardInstance.addLog(`⏭️  Đã bỏ qua nhiệm vụ (ID: ${jobInfo ? jobInfo.jobId : 'N/A'}) vì "${error.message}"`, 'info');
                    jobSkipped = true;
                } else {
                    dashboardInstance.addLog(`❌ Lỗi nghiêm trọng: ${error.message}`, 'error');
                    statisticsInstance.addError(error);
                    await reportError();
                }
            } finally {
                if (!jobSkipped) {
                    const jobTime = Date.now() - jobStartTime;
                    statisticsInstance.addJob(jobSuccess, jobInfo || { earnings: 0, type: 'N/A', jobId: 'N/A' }, jobTime);
                }
                if (isRunning) {
                    dashboardInstance.addLog('⏳ Đợi chút xíu trước khi nhận job tiếp theo...', 'info');
                    await delay(6000, 12000);
                }
            }
        }
    }

    // --- Hàm điều khiển Tool ---
    function startTool() {
        if (!isRunning) {
            isRunning = true;
            statisticsInstance.reset();
            statisticsInstance.startTimer();
            document.getElementById('startBtn').classList.add('active');
            document.getElementById('stopBtn').classList.remove('active');
            dashboardInstance.addLog('🚀 Bắt đầu chạy tool GoLike SHOPPE...', 'success');
