    // --- Class quản lý thống kê ---
    class Statistics {
        constructor() {
            this.dashboardElement = null;
            this.reset();
            this.intervalId = null;
        }

        reset() {
            this.stats = {
                totalJobs: 0,
                successfulJobs: 0,
                failedJobs: 0,
                totalErrors: 0,
                totalEarnings: 0,
                startTime: null,
                errors: [],
                averageJobTime: 0,
                currentStreak: 0,
                bestStreak: 0,
                lastJobInfo: null,
                jobsPerMinute: 0,
                earningsPerMinute: 0
            };
            if (this.intervalId) {
                clearInterval(this.intervalId);
                this.intervalId = null;
            }
        }

        startTimer() {
            if (!this.stats.startTime) {
                this.stats.startTime = new Date();
                this.intervalId = setInterval(() => {
                    if (isRunning) {
                        this.updateDashboard();
                    } else {
                        clearInterval(this.intervalId);
                        this.intervalId = null;
                    }
                }, 1000);
            }
        }

        stopTimer() {
            if (this.intervalId) {
                clearInterval(this.intervalId);
                this.intervalId = null;
            }
            this.stats.startTime = null;
        }

        addJob(success, jobInfo, jobTime = 0) {
            this.stats.totalJobs++;
            this.stats.lastJobInfo = jobInfo;
            
            if (success) {
                this.stats.successfulJobs++;
                this.stats.totalEarnings += jobInfo.earnings || 0;
                this.stats.currentStreak++;
                this.stats.bestStreak = Math.max(this.stats.bestStreak, this.stats.currentStreak);
            } else {
                this.stats.failedJobs++;
                this.stats.currentStreak = 0;
            }
            
            if (this.stats.totalJobs === 1) {
                this.stats.averageJobTime = jobTime;
            } else {
                this.stats.averageJobTime = 
                    ((this.stats.averageJobTime * (this.stats.totalJobs - 1)) + jobTime) / this.stats.totalJobs;
            }
            this.updateDashboard();
        }

        addError(error) {
            this.stats.errors.push({
                message: error.message,
                timestamp: new Date()
            });
            this.stats.totalErrors++;
            this.updateDashboard();
        }

        getRunningTime() {
            if (!this.stats.startTime) return "00h 00m 00s";
            const diff = new Date() - this.stats.startTime;
            const hours = Math.floor(diff / 3600000);
            const minutes = Math.floor((diff % 3600000) / 60000);
            const seconds = Math.floor((diff % 60000) / 1000);
            return `${hours.toString().padStart(2, '0')}h ${minutes.toString().padStart(2, '0')}m ${seconds.toString().padStart(2, '0')}s`;
        }
        
        formatCurrency(amount) {
            return new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(amount);
        }

        updateDashboard() {
            if (!this.dashboardElement) return;

            const statsContent = this.dashboardElement.querySelector('.stats-content');
            if (!statsContent) return;

            const successRate = this.stats.totalJobs ? 
                ((this.stats.successfulJobs / this.stats.totalJobs) * 100).toFixed(1) : 0;
            
            const avgJobTimeSeconds = (this.stats.averageJobTime / 1000).toFixed(1);
            const elapsedTimeInMinutes = this.stats.startTime ? (new Date() - this.stats.startTime) / (1000 * 60) : 0;
            this.stats.jobsPerMinute = elapsedTimeInMinutes > 0 ? (this.stats.successfulJobs / elapsedTimeInMinutes).toFixed(2) : 0;
            this.stats.earningsPerMinute = elapsedTimeInMinutes > 0 ? (this.stats.totalEarnings / elapsedTimeInMinutes).toFixed(0) : 0;
            
            const startTimeFormatted = this.stats.startTime ? 
                this.stats.startTime.toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit', second: '2-digit' }) : 'N/A';

            statsContent.innerHTML = `
                <div class="stats-grid">
                    <div class="stat-item">
                        <span>Tổng nhiệm vụ</span>
                        <span>${this.stats.totalJobs}</span>
                    </div>
                    <div class="stat-item">
                        <span>Thành công</span>
                        <span>${this.stats.successfulJobs}</span>
                    </div>
                    <div class="stat-item">
                        <span>Thất bại</span>
                        <span>${this.stats.failedJobs}</span>
                    </div>
                    <div class="stat-item">
                        <span>Tổng lỗi</span>
                        <span>${this.stats.totalErrors}</span>
                    </div>
                    <div class="stat-item full-width">
                        <span>Tỷ lệ thành công</span>
                        <span>${successRate}%</span>
                    </div>
                </div>
                <div class="progress-bar-wrapper">
                    <div class="progress-fill" style="width: ${successRate}%"></div>
                </div>
                <div class="stats-grid">
                    <div class="stat-item">
                        <span>Tổng thu nhập</span>
                        <span>${this.formatCurrency(this.stats.totalEarnings)}</span>
                    </div>
                    <div class="stat-item">
                        <span>Job/phút</span>
                        <span>${this.stats.jobsPerMinute}</span>
                    </div>
                    <div class="stat-item">
                        <span>Xu/phút</span>
                        <span>${this.formatCurrency(this.stats.earningsPerMinute)}</span>
                    </div>
                    <div class="stat-item">
                        <span>Chuỗi thắng</span>
                        <span>${this.stats.currentStreak} (Tốt nhất: ${this.stats.bestStreak})</span>
                    </div>
                </div>
                <div class="stat-item full-width">
                    <span>Thời gian bắt đầu</span>
                    <span>${startTimeFormatted}</span>
                </div>
                <div class="stat-item full-width">
                    <span>Thời gian chạy</span>
                    <span>${this.getRunningTime()}</span>
                </div>
                <div class="stat-item full-width">
                    <span>T.gian TB/n.vụ</span>
                    <span>${avgJobTimeSeconds}s</span>
                </div>
                ${this.stats.lastJobInfo ? `
                <div class="stat-item full-width">
                    <span>Job gần nhất</span>
                    <span>${this.stats.lastJobInfo.type || 'N/A'} (#${this.stats.lastJobInfo.jobId || 'N/A'})</span>
                </div>
                ` : ''}
            `;
        }
    }

