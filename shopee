            const errorButton = await waitForElement("button.btn.btn-block.b-0.bg-button-1.px-0:has(img[src*='error.svg'])", 10000);
            if (!errorButton) {
                dashboardInstance.addLog('❌ Không tìm thấy nút báo lỗi, bỏ qua báo cáo.', 'error');
                return false;
            }
            dashboardInstance.addLog('✓ Tìm thấy nút báo lỗi, đang click...', 'info');
            await safeClick(errorButton, [1000, 2000], [2000, 3000]);

            // Chọn lý do báo lỗi
            const firstReason = await waitForElement(".modal-body .row.align-items-center.mt-2:first-child", 10000);
            if (!firstReason) {
                dashboardInstance.addLog('❌ Không tìm thấy lý do báo lỗi, bỏ qua báo cáo.', 'error');
                return false;
            }
            dashboardInstance.addLog('✓ Tìm thấy lý do báo lỗi, đang chọn...', 'info');
            await safeClick(firstReason, [1000, 2000], [2000, 3000]);

            // Đợi nút gửi báo cáo xuất hiện
            dashboardInstance.addLog('⏳ Chờ nút gửi báo cáo xuất hiện...', 'info');
            await delay(1000, 1500);
            
            const submitButton = document.querySelector("button.btn.btn-primary.btn-sm.form-control.mt-3");
            if (!submitButton) {
                dashboardInstance.addLog('❌ Không tìm thấy nút gửi báo cáo, bỏ qua báo cáo.', 'error');
                return false;
            }

            // Kiểm tra và bật enable nút nếu bị disable
            if (submitButton.disabled) {
                dashboardInstance.addLog('⚡ Nút gửi báo cáo bị disabled, đang kích hoạt...', 'info');
                submitButton.disabled = false;
                await delay(200, 400);
            }

            // Scroll nút vào view
            submitButton.scrollIntoView({ behavior: 'smooth', block: 'center' });
            dashboardInstance.addLog('✓ Scroll nút gửi báo cáo vào view...', 'info');
            await delay(500, 800);

            // Thử click bằng phương pháp an toàn
            try {
                dashboardInstance.addLog('🖱️  Đang click nút gửi báo cáo (phương pháp 1)...', 'info');
                submitButton.click();
                await delay(800, 1200);
            } catch (err) {
                dashboardInstance.addLog('⚠️  Phương pháp click thứ 1 thất bại, thử phương pháp 2 (dispatch event)...', 'error');
                
                // Phương pháp 2: Dispatch MouseEvent
                const mouseEvent = new MouseEvent('click', {
                    bubbles: true,
                    cancelable: true,
                    view: window,
                    buttons: 1
                });
                submitButton.dispatchEvent(mouseEvent);
                await delay(1000, 1500);
            }

            // Kiểm tra xác nhận - modal có đóng không
            const modal = document.querySelector('.modal.show, .swal2-container.swal2-shown');
            if (modal && modal.offsetParent !== null) {
                dashboardInstance.addLog('⚠️  Modal vẫn mở sau khi click, thử click lại...', 'error');
                
                // Thử lại lần nữa
                try {
                    const submitBtn2 = document.querySelector("button.btn.btn-primary.btn-sm.form-control.mt-3");
                    if (submitBtn2) {
                        submitBtn2.disabled = false;
                        submitBtn2.click();
                        await delay(1500, 2000);
                    }
                } catch (err2) {
                    dashboardInstance.addLog('❌ Lần thử lại cũng thất bại: ' + err2.message, 'error');
                    return false;
                }
            }

            // Cuối cùng, kiểm tra modal đã đóng hay chưa
            const modalStillOpen = document.querySelector('.modal.show, .swal2-container.swal2-shown');
            if (!modalStillOpen || modalStillOpen.offsetParent === null) {
                dashboardInstance.addLog('✅ Báo cáo lỗi thành công! Modal đã đóng.', 'success');
                return true;
            } else {
                dashboardInstance.addLog('❌ Không thể đóng modal báo cáo lỗi.', 'error');
                return false;
            }

        } catch (e) {
            if (e.type === 'TOOL_STOPPED') throw e;
            dashboardInstance.addLog(`❌ Lỗi trong quá trình báo cáo: ${e.message}`, 'error');
            return false;
        }
    }

    async function handleAlreadyDonePopup() {
        try {
            const popupContent = document.getElementById('swal2-content');
            if (popupContent && popupContent.style.display !== 'none') {
